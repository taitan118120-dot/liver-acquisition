# このファイルを .env にコピーして中身を埋める（.env は Git に上げない）
# アカウント作成後、instagram_setup.md の手順でトークンを取得して貼る。

# --- Instagram Graph API（アカウント作成後に必須） ---
IG_ACCESS_TOKEN=
IG_BUSINESS_ID=

# --- Gemini（写真解析・文章生成。今すぐ入れられる） ---
GEMINI_API_KEY=

# --- サロン情報 ---
SALON_NAME=
SALON_AREA=石川県小松市
SALON_BOOKING_URL=

# --- アプリのあいことば（お母さんがログインに使う） ---
NAIL_APP_PASSWORD=nail

# --- 動作 ---
# true=写真を選んだら即投稿 / false=下書き（確認後に投稿）
NAIL_AUTO_POST=true
