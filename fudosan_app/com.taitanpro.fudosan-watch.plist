<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.taitanpro.fudosan-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mitataisei/ライバー獲得/fudosan_app/run.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mitataisei/ライバー獲得/fudosan_app</string>

    <!-- 市の台帳更新は不定期なので 8:00 / 13:00 / 19:00 の1日3回で十分 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/mitataisei/ライバー獲得/fudosan_app/data/watch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mitataisei/ライバー獲得/fudosan_app/data/watch.log</string>
</dict>
</plist>
