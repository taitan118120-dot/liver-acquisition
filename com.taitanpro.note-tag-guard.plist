<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.taitanpro.note-tag-guard</string>

  <!-- Note公開記事のタグ付け忘れを毎日自動監査＋修復（安全網） -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/mitataisei/ライバー獲得/note_tag_guard.py</string>
    <string>--fix</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/mitataisei/ライバー獲得</string>

  <key>StandardOutPath</key>
  <string>/Users/mitataisei/ライバー獲得/data/note_tag_guard.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mitataisei/ライバー獲得/data/note_tag_guard.log</string>

  <!-- 23:10（日中の投稿がすべて終わった後にまとめて回収）＋ 09:10（保険）。
       スリープ中の起動はスキップされ、実測で約半数の夜が名前解決失敗で落ちていたため、
       時刻を2つにして片方が潰れても翌朝に回収できるようにしてある。
       スクリプト側も起動時にネット到達性を数分待つ（note_tag_guard.py wait_for_network）。
       監査は冪等なので1日2回走っても副作用はない。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>10</integer></dict>
  </array>
</dict>
</plist>
