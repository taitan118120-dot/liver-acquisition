81%E3%81%AA%E3%81%84%E3%81%9F%E3%82%81%E3%81%AE%E6%96%B0%E5%B8%B8%E8%AD%98%E3%80%902026%E5%B9%B4%E7%89%88%E3%80%91%EF%BD%9C%E3%81%9F%E3%81%84%E3%81%9F%E3%82%93%E2%98%95%EF%B8%8F%E2%9D%A4%EF%B8%8F%EF%BC%A0150%E5%90%8D%E6%89%80%E5%B1%9E%E3%83%A9%E3%82%A4%E3%83%90%E3%83%BC%E4%BA%8B%E5%8B%99%E6%89%80%E4%BB%A3%E8%A1%A8+%40taitan_LIVER&related=taitan_LIVER,note_PR", "note_url": "https://note.com/taitan_118/n/n0144caabbb73", "twitter_related_accounts": "taitan_LIVER,note_PR", "tweet_text": "ライバーになる条件を知らないまま始めると、9割の人が半年で消える｜夢を諦めないための新常識【2026年版】｜たいたん☕️❤️＠150名所属ライバー事務所代表 @taitan_LIVER", "circle_plans": [], "is_public_membership_connected": false, "is_board_disabled": false, "discount_campaigns": [], "lead_form": null, "line_add_friend": null, "line_add_friend_note_enable_feature": false, "line_add_friend_access_token": null, "note_share_total_count": 0, "note_share_provider_details": {}, "is_published_preview_note": false, "is_ratable": false, "content_rating_via": "", "content_raters": [], "my_rating_exists": false, "rater_count": 0, "is_recently_purchased": false, "requires_login_for_purchase": false, "is_recently_tip": false, "exclude_from_creator_top": false, "exclude_ai_learning_reward": false, "translation_setting": null, "is_related_with_investment": false, "related_stocks": [], "translation": {"available_languages": ["en-US"]}}